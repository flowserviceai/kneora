<section class="wrap section-space"><div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a></div><div class="product-grid">{% if section.settings.collection %}{% for item in section.settings.collection.products limit: 4 %}{% render 'product-card', item: item %}{% endfor %}{% elsif settings.main_product %}{% render 'product-card', item: settings.main_product %}{% endif %}</div></section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet your after-work routine."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
