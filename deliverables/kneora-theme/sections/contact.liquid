<section class="wrap section-space contact-grid"><div><h1>{{ 'contact.title' | t }}</h1><p class="lede">{{ 'contact.intro' | t }}</p>{% if settings.support_email != blank %}<a class="text-link" href="mailto:{{ settings.support_email | escape }}">{{ settings.support_email | escape }}</a>{% endif %}{% if settings.support_hours != blank %}<p>{{ settings.support_hours | escape }}</p>{% endif %}</div>{% form 'contact', class: 'contact-form' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">{{ 'general.sent' | t }}</p>{% endif %}<label for="ContactName">{{ 'general.name' | t }}</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}"><label for="ContactEmail">{{ 'general.email' | t }}</label><input id="ContactEmail" name="contact[email]" type="email" required autocomplete="email" value="{{ form.email | escape }}"><label for="ContactBody">{{ 'general.message' | t }}</label><textarea id="ContactBody" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea><button class="button">{{ 'general.send' | t }}</button>{% endform %}</section>
{% schema %}
{
  "name": "Contact",
  "settings": [],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
