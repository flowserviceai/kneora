{% if section.blocks.size > 0 %}<section class="wrap section-space faq-layout"><h2>{{ section.settings.heading | escape }}</h2><div>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>{% endif %}
{% schema %}
{
  "name": "Questions and answers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good questions. Clear answers."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Does one device serve both knees?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. One unit has two separate knee openings and a central divider.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions and answers"
    }
  ]
}
{% endschema %}
