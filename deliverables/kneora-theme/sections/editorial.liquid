{% if section.settings.enabled %}<section class="editorial section-space {% if section.settings.dark %}dark-section{% endif %}"><div class="wrap editorial-grid {% if section.settings.reverse %}reverse{% endif %}"><div><h2>{{ section.settings.heading | escape }}</h2><div class="rte lede">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}</div>{% if section.settings.image %}<div class="editorial-media">{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400' }}</div>{% elsif section.blocks.size > 0 %}<div class="spec-list">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.text }}</div></div>{% endfor %}</div>{% endif %}</div></section>{% endif %}
{% schema %}
{
  "name": "Editorial story",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed around both knees."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>One continuous housing. Two separate knee openings. A central divider keeps the shape clear and considered.</p>"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Navy background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse desktop columns",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Approved image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore the details"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "360 \u00d7 242 \u00d7 160 mm"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Overall device dimensions.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial story"
    }
  ]
}
{% endschema %}
