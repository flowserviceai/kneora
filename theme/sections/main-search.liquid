<section class="wrap section-space"><h1>{{ 'general.search' | t }}</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label for="SearchInput">{{ 'general.search_label' | t }}</label><div class="inline-form"><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" required><button class="button">{{ 'general.search' | t }}</button></div></form>{% if search.performed %}{% paginate search.results by 12 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', item: item %}{% else %}<article><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2></article>{% endif %}{% else %}<p>{{ 'general.search_empty' | t }}</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>
{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
