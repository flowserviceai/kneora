{% doc %}
Renders the server-side cart form for both cart page and drawer.
@param {string} uid - Unique cart context.
{% enddoc %}
{% if cart.empty? %}<div class="empty-cart"><p>{{ 'general.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue' | t }}</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" class="cart-form"><div class="cart-items">{% for item in cart.items %}<div class="cart-item">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy' }}{% endif %}<div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<div>{{ item.final_line_price | money }}</div><label for="CartQty-{{ uid }}-{{ forloop.index }}">{{ 'general.quantity' | t }}</label><input id="CartQty-{{ uid }}-{{ forloop.index }}" name="updates[]" type="number" min="0" step="1" value="{{ item.quantity }}" data-line="{{ forloop.index }}"><a href="{{ item.url_to_remove }}">{{ 'general.remove' | t }}</a></div></div>{% endfor %}</div><div class="cart-total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<p>{{ 'general.shipping_note' | t }}</p><button class="button secondary" name="update">{{ 'general.update' | t }}</button><button class="button" name="checkout">{{ 'general.checkout' | t }}</button></form>{% endif %}
